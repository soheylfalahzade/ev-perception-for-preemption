{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EmergencyVehicleEvent",
  "type": "object",
  "required": [
    "schema_version",
    "timestamp_s",
    "track_id",
    "edge_id",
    "confidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "timestamp_s": {
      "type": "number",
      "description": "capture time of the confirming frame"
    },
    "track_id": {
      "type": "integer"
    },
    "edge_id": {
      "type": "string",
      "description": "road-graph edge the vehicle is matched to"
    },
    "s_m": {
      "type": "number",
      "description": "arc-length position along the edge"
    },
    "dist_to_stop_line_m": {
      "type": "number",
      "description": "distance to the edge end"
    },
    "eta_s": {
      "type": "number",
      "description": "dist_to_stop_line_m / max(speed, 1 m/s)"
    },
    "heading_deg": {
      "type": [
        "number",
        "null"
      ],
      "description": "compass-free math angle, deg"
    },
    "speed_mps": {
      "type": "number"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "match_prob": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "latency_ms": {
      "type": "number",
      "description": "processing time of the confirming frame"
    }
  }
}
